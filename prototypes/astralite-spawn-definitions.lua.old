-- return asteroid_functions


-- set default to 1 higher values are for testing
local astralite_probability_multiplier = 100


local astralite = {}

local asteroid_sizes = {
    {
        asteroid = "astralite-asteroid-chunk",
        type = "asteroid-chunk",

        probability = {
            {position = 0.1, probability = 0.006},
            {position = 0.9, probability = 0.002},
        }
    },
    {
        asteroid = "small-astralite-asteroid",

        probability = {
            {position = 0.1, probability = 0.003},
            {position = 0.5, probability = 0.004},
            {position = 0.9, probability = 0.002},
        }
    },
    {
        asteroid = "medium-astralite-asteroid",

        probability = {
            {position = 0.1, probability = 0.0002},
            {position = 0.5, probability = 0.002},
            {position = 0.9, probability = 0.002},
        }
    },
    {
        asteroid = "big-astralite-asteroid",

        probability = {
            {position = 0.1, probability = 0},
            {position = 0.5, probability = 0.0005},
            {position = 0.9, probability = 0.00015},
        }
    },
    {
        asteroid = "huge-astralite-asteroid",

        probability = {
            {position = 0.1, probability = 0},
            {position = 0.5, probability = 0},
            {position = 0.9, probability = 0.0005},
        }
    },
}

local function interpolate(points, position)
    if position <= points[1].position then
        return points[1].probability
    end

    for i = 1, #points -1 do
        local a = points[i]
        local b = points[i + 1]

        if position <= b.position then
            local t = 
                (position - a.position) /
                (b.position - a.position)

            return a.probability + (b.probability - a.probability) * t
        end
    end
    return points[#points].probability
end

function astralite.spawn_definitions()
    local definitions = {}

    for _, size in ipairs(asteroid_sizes) do
        local spawn_points = {}

        for _, point in ipairs(size.probability) do
            table.insert(
                spawn_points,
                {
                    distance = point.position,
                    probability = interpolate(
                        size.probability,
                        point.position
                    ) * astralite_probability_multiplier,
                    speed = 0.0169
                }
            )
        end

        local definition = {
            asteroid = size.asteroid,
            spawn_points = spawn_points
        }

        if size.type then
            definition.type = size.type
        end

        table.insert(definitions, definition)
    end
    return definitions
end

return astralite